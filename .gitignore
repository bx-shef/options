# Линтер: инструменты разработчика и его кеш. В git их нет, значит нет и в
# архиве — build.sh собирает из списка отслеживаемых файлов.
/vendor/
/.php-cs-fixer.cache

/.versions
/bitrix-version-builder

*.log

# Отзывы о навыках: их пишет агент по shef-feedback, в репозиторий они не едут.
# Без этой строки первый же git add -A роняет check_lists в build.sh.
/.bitrixsh/
install/**/*.min.min.*

# собирается build.sh
/shef.options.zip

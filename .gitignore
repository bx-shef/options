/.idea
.DS_Store

composer.phar

# composer.lock НЕ игнорируется намеренно. Точная версия php-cs-fixer в
# composer.json пришпиливает сам инструмент, но не три десятка его
# зависимостей: без lock CI разрешал бы их заново на каждом прогоне, и
# неудачный выпуск любой из них ронял бы Lint на коммите, который ничего не
# менял. Ровно то, ради чего версия и пришпилена.

# Линтер: инструменты разработчика и его кеш. В git их нет, значит нет и в
# архиве — build.sh собирает из списка отслеживаемых файлов.
/vendor/
/.php-cs-fixer.cache

/.versions
/bitrix-version-builder

*.log

# Отзывы о навыках: их пишет агент по shef-feedback, в репозиторий они не едут.
# Без этой строки первый же git add -A роняет check_lists в build.sh.
/.bitrixsh/
install/**/*.min.min.*

# собирается build.sh
/shef.options.zip
